{% assign collection_section = section.settings.collection_list  %}



<body>
  <section>
    {% render 'header' %}
    <main>
      <div class="banner-container">
        <div class="swiper">
          <div class="swiper-wrapper">
            {% for info-banner in section.blocks %}
              <div class="slider">
                <img
                  src="{{info-banner.settings.Image-banner |  image_url: width: nil }}"
                  alt="{{info-banner.settings.Image-banner.alt}}"
                  width="auto"
                  height="auto">
              </div>
              <div class="content-banner">
    
                    <h1 class="banner-description">{{info-banner.settings.title-banner}}</h1>

                <p class="banner-description">{{info-banner.settings.description-banner}}</p>
                
                <button class="button-banner"><a href="{{info-banner.settings.button-banner}}">{{info-banner.settings.btn-text}}</a></button>

              </div>
            {% endfor %}
          </div>

          <div class="swiper-pagination"></div>

          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>

          <div class="swiper-scrollbar"></div>
        </div>
      </div>


      <div class="colletion- container">

      <div class="collection-products">
        {%for products in collection_section.products%}
            <img src="{{products.featured_image |  image_url: width: 100 , height: 100 }}" alt="{{products.featured_image.alt}}" width="auto" height="auto">
            <h2>{{products.title}}</h2>
            <h2>{{products.price |  money}}</h2>
            <button><a href="{{products.url}}">Compre Agora</a></button>
           
        {% endfor %}
      </div>

      </div>
    </main>
  </section>
</body>

{% schema %}
{
  "name": "home",
  "settings": [
    {
      "type": "collection",
      "id": "collection_list",
      "label": "Coleção de Produtos"
    }
  ],
  "blocks": [
    {
      "name": "Banner",
      "type": "image",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "Image-banner",
          "label": "Imagem Banner"
        },

        {
          "type": "text",
          "id": "title-banner",
          "label": "Texto do Banner"
        },

        {
          "type": "richtext",
          "id": "description-banner",
          "label": "Descrição do Banner"
        },

        {
          "type": "text",
          "id": "btn-text",
          "label": "Texto do Botão"
        },

        {
          "type": "url",
          "id": "button-banner",
          "label": "Link do Botão"
        },
      ]
    }
  ]
}
{% endschema %}
