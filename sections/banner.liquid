{{ 'slider-banner.js' | asset_url | script_tag }}
{{ 'slider-banner.css' | asset_url | stylesheet_tag }}
{% render 'variables-banner' %}

<section>
  <main>
    <div class="banner-container ">
      <div class="swiper">
        <div class="swiper-wrapper ">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <img
                src="{{ block.settings.image_banner |  image_url}}"
                alt="{{ block.settings.image_banner.alt}} "
                width="auto"
                height="auto"
              >
              <div class="content-banner content-banner--{{ block.id }}">
                <h1>{{ block.settings.title_banner }}</h1>
                <div class="description_banner description_banner--{{ block.id }}">
                  {{ block.settings.description_banner }}
                </div>
              </div>
              {% if block.settings.btn_banner != blank %}
                <button class="button-banner button-banner--{{ block.id }}">
                  <a href="{{ block.settings.btn_banner}}">{{ block.settings.btn_text }}</a>
                </button>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <div class="swiper-pagination"></div>

        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
    </div>
  </main>
</section>

{% schema %}
{
  "name": "banner",
  "settings": [],
  "blocks": [
    {
      "name": "Banner",
      "type": "image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image_banner",
          "label": "Adicione a imagem para o banner"
        },

        {
          "type": "header",
          "content": "Configurações do Título do Banner"
        },

        {
          "type": "text",
          "id": "title_banner",
          "label": "Digite o titulo do Banner"
        },

        {
          "type": "color",
          "id": "color_text_title_banner",
          "label": "Escolha uma cor para o título banner",
          "default": "#000"
        },

        {
          "type": "font_picker",
          "id": "font_text_title_banner",
          "label": "Escolha a fonte para o título do banner",
          "default": "arial_n7"
        },

        {
          "type": "range",
          "id": "size_text_title_banner",
          "label": "Escolha o tamanho do texto do título do produto",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 20
        },

        {
          "type": "header",
          "content": "Configurações da Descrição do Banner"
        },

        {
          "type": "richtext",
          "id": "description_banner",
          "default": "<p> Descrição do banner</p>",
          "label": "Digite a descrição do banner"
        },

        {
          "type": "color",
          "id": "color_text_description_banner",
          "label": "Escolha uma cor para a descrição banner",
          "default": "#000"
        },

        {
          "type": "font_picker",
          "id": "font_text_description_banner",
          "label": "Escolha a fonte para a descrição do banner",
          "default": "arial_n7"
        },

        {
          "type": "range",
          "id": "size_text_description_banner",
          "label": "Escolha o tamanho do texto da descrição do produto",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 14
        },

        {
          "type": "header",
          "content": "Configurações do Botão"
        },

        {
          "type": "text",
          "id": "btn_text",
          "label": "Texto do Botão"
        },

        {
          "type": "url",
          "id": "btn_banner",
          "label": "Link do Botão"
        },

        {
          "type": "header",
          "content": "Cores do Botão"
        },

        {
          "type": "color",
          "id": "btn_color_banner",
          "label": "Mude a cor do botão",
          "default": "#000"
        },

        {
          "type": "color",
          "id": "btn_text_color_banner",
          "label": "Mude a cor do texto do botão",
          "default": "#fff"
        },

        {
          "type": "color",
          "id": "btn_banner_color_border",
          "label": "Mude a cor da borda do botão",
          "default": "#fff"
        },

        {
          "type": "header",
          "content": "Tamanhos do texto do botão"
        },

        {
          "type": "font_picker",
          "id": "font_text_btn_banner",
          "label": "Escolha a fonte para o texto do botão",
          "default": "arial_n7"
        },

        {
          "type": "range",
          "id": "size_text_btn_banner",
          "label": "Tamanho do Texto",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 12
        },

        {
          "type": "header",
          "content": "Tamanhos do Botão"
        },

        {
          "type": "range",
          "id": "button__banner_padding_y",
          "label": "Altura interna do botão",
          "min": 6,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 70
        },
        {
          "type": "range",
          "id": "button_banner_padding_x",
          "label": "Largura interna do botão",
          "min": 10,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 40
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "banner"
    }
  ]
}
{% endschema %}
