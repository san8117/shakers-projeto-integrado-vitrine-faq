{{ 'slider-banner.js' | asset_url | script_tag }}
{{ 'slider-banner.css' | asset_url | stylesheet_tag }}
<body>
    <section>
       <main>
      <div class="banner-container">
        <div class="swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide">
                <img
                  src="{{ block.settings.image_banner |  image_url}}"
                  alt="{{ block.settings.image_banner.alt}}">
              </div>
              <div class="content-banner">
                <h1 class="banner-title">{{ block.settings.title_banner}}</h1>
                <p class="banner-description">{{ block.settings.description_banner }}</p>
                </div>

              <div class="button-banner">
                   <button>
                  <a href="{{ block.settings.btn_banner}}">{{ block.settings.btn_text}}</a>
                </button>
              </div>
            {% endfor %}
          </div>

          <div class="swiper-pagination"></div>

          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>

       
        </div>
        </main>
    </section>
</body>


{% schema %}
{
  "name": "banner",
  "settings": [],
  "blocks": [
    {
      "name": "Banner",
      "type": "image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image_banner",
          "label": "Imagem Banner"
        },

        {
          "type": "richtext",
          "id": "title_banner",
          "default": "<p> PROJETO INTEGRADO</p>",
          "label": "Digite o titulo do Banner"
        },

        {
          "type": "richtext",
          "id": "description_banner",
          "default": "<p> TESTE DESCRIÇÃO BANNER</p>",
          "label": "Digite a descrição do banner"
        },

        {
          "type": "text",
          "id": "btn_text",
          "label": "Texto do Botão"
        },

        {
          "type": "url",
          "id": "btn_banner",
          "label": "Link do Botão"
        },

        {
          "type": "header",
          "content": "Cores"
        },

        {
          "type": "color",
          "id" : "color_text",
          "label": "Cores do Texto"
        },

           {
          "type": "color",
          "id" : "color_button_text",
          "label": "Cor do texto do botão"
        },

         {
          "type": "color",
          "id" : "color_button",
          "label": "Cores do Botão"
        }
      ]
    }
  ],

  "presets": [
    {
        "name": "banner"
    }
  ]
}
{% endschema %}
