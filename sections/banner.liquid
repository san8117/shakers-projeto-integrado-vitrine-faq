{{ 'slider-banner.js' | asset_url | script_tag }}
{{ 'slider-banner.css' | asset_url | stylesheet_tag }}
{% render 'variables-banner' %}

<section>
  <main>
    <div class="banner-container banner-container--{{ section.id }}">
      <div class="swiper">
        <div class="swiper-wrapper ">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <img
                src="{{ block.settings.image_banner |  image_url}}"
                alt="{{ block.settings.image_banner.alt}} "
                width="auto"
                height="auto"
              >
              <div class="content-banner content-banner--{{ block.id }}">
                <h1>{{ block.settings.title_banner }}</h1>
                {{ block.settings.description_banner }}
              </div>
              {% if block.settings.btn_banner != blank %}
                <button class="button-banner">
                  <a href="{{ block.settings.btn_banner}}">{{ block.settings.btn_text }}</a>
                </button>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <div class="swiper-pagination"></div>

        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
      </div>
    </div>
  </main>
</section>

{% schema %}
{
  "name": "banner",
  "settings": [],
  "blocks": [
    {
      "name": "Banner",
      "type": "image",

      "settings": [
        {
          "type": "image_picker",
          "id": "image_banner",
          "label": "Adicione a imagem para o banner"
        },

        {
          "type": "header",
          "content": "Configurações do Título do Banner"
        },

        {
          "type": "text",
          "id": "title_banner",
          "label": "Digite o titulo do Banner"
        },

        {
          "type": "color",
          "id": "color_text_title_banner",
          "label": "Escolha uma cor para o título banner",
          "default": "#000"
        },

        {
          "type": "font_picker",
          "id": "font_text_title_banner",
          "label": "Escolha a fonte para o título do banner",
          "default": "arial_n7"
        },

        {
          "type": "range",
          "id": "size_text_title_banner",
          "label": "Escolha o tamanho do texto do título do produto",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 20
        },

        {
          "type": "richtext",
          "id": "description_banner",
          "default": "<p> TESTE DESCRIÇÃO BANNER</p>",
          "label": "Digite a descrição do banner"
        },

        {
          "type": "text",
          "id": "btn_text",
          "label": "Texto do Botão"
        },

        {
          "type": "url",
          "id": "btn_banner",
          "label": "Link do Botão"
        },


        {
          "type": "color",
          "id": "color_button",
          "label": "Cores do Botão"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "banner"
    }
  ]
}
{% endschema %}
