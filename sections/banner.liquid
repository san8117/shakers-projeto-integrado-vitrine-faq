{{ 'slider-banner.js' | asset_url | script_tag }}
{{ 'slider-banner.css' | asset_url | stylesheet_tag }}
<body>
    <section>
        <main>
                  <div class="banner-container">
        <div class="swiper">
          <div class="swiper-wrapper">
            {% for info-banner in section.blocks %}
              <div class="swiper-slide">
                <img
                  src="{{info-banner.settings.Image-banner |  image_url: width: 100 }}"
                  alt="{{info-banner.settings.Image-banner.alt}}"
                  width="auto"
                  height="auto"
                >
              </div>
              <div class="content-banner">
                <h1 class="banner-description">{{ info-banner.settings.title-banner }}</h1>

                <p class="banner-description">{{ info-banner.settings.description-banner }}</p>

                <button class="button-banner">
                  <a href="{{info-banner.settings.button-banner}}">{{ info-banner.settings.btn-text }}</a>
                </button>
              </div>
            {% endfor %}
          </div>

          <div class="swiper-pagination"></div>

          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>

       
        </div>
        </main>
    </section>
</body>


{% schema %}
{
  "name": "banner",
  "settings": [],
  "blocks": [
    {
      "name": "Banner",
      "type": "image",

      "settings": [
        {
          "type": "image_picker",
          "id": "Image-banner",
          "label": "Imagem Banner"
        },

        {
          "type": "text",
          "id": "title-banner",
          "label": "Texto do Banner"
        },

        {
          "type": "richtext",
          "id": "description-banner",
          "label": "Descrição do Banner"
        },

        {
          "type": "text",
          "id": "btn-text",
          "label": "Texto do Botão"
        },

        {
          "type": "url",
          "id": "button-banner",
          "label": "Link do Botão"
        }
      ]
    }
  ],

  "presets": [
    {
        "name": "banner"
    }
  ]
}
{% endschema %}
