{{'product-faq.css' |  asset_url | stylesheet_tag}}
{% render 'variables-product-faq' %}
{% assign faq_item = product.metafields.custom.product_faq.value %}

<section>
    <main>
        {% if faq_item != blank %}
           {% for faq_options in faq_item %}
            {% assign question = faq_options.pergunta %}
            {% assign answer = faq_options.resposta %}

            <div class="question-answer-container">
                <h2 class="question-faq">{{question}}</h2>
                <div class="answer-faq">
                  <p >{{answer |  metafield_tag}}</p>
                </div>
                <hr>
            </div>
            
           {% endfor %}         
        {% endif %}

    </main>
</section>


{% schema %}
{
  "name": "product-faq",
  "settings": [
    {
      "type": "header",
      "content": "Configuração das perguntas"

    },

    {
      "type": "color",
      "id": "product_faq_question_color",
      "label": "Escolha uma cor para as perguntas ",
      "default": "#000"
    },

    {
      "type": "font_picker",
      "id": "font_product_faq",
      "label": "Escolha a fonte para as perguntas",
      "default": "arial_n7"
    },

     {
      "type": "range",
      "id": "size_text_product_faq",
      "label": "Tamanho do texto do para as perguntas",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Configuração das respostas"

    },

    {
      "type": "color",
      "id": "product_faq_answer_color",
      "label": "Escolha uma cor para as respostas ",
      "default": "#000"
    },

    {
      "type": "font_picker",
      "id": "font_product_faq_answer",
      "label": "Escolha a fonte para as respostas",
      "default": "arial_n7"
    },

     {
      "type": "range",
      "id": "size_text_product_faq_answer",
      "label": "Tamanho do texto do para as respostas",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Configuração de fundo da seção"

    },

    {
      "type": "color",
      "id": "product_faq_bg_color",
      "label": "Escolha uma cor para o fundo da seção ",
      "default": "#fff"
    },
  ],

  "presets": [
  {
    "name": "product-faq"
    
  }
]

}
{% endschema %}
